test modified_csi_arrows_decode_with_their_modifiers(
    &testing::UnitTest t
) {
    [6]u8 shiftUp = [27, 91, 49, 59, 50, 65];
    [6]u8 altRight = [27, 91, 49, 59, 51, 67];
    [6]u8 controlLeft = [27, 91, 49, 59, 53, 68];
    [6]u8 allDown = [27, 91, 49, 59, 56, 66];

    assert_key_event(
        t,
        fletui::decode_escape_sequence(shiftUp[:]),
        fletui::KeyCode.Up,
        0,
        true,
        false,
        false,
        "CSI 1;2 A decodes as Shift+Up"
    );
    assert_key_event(
        t,
        fletui::decode_escape_sequence(altRight[:]),
        fletui::KeyCode.Right,
        0,
        false,
        true,
        false,
        "CSI 1;3 C decodes as Alt+Right"
    );
    assert_key_event(
        t,
        fletui::decode_escape_sequence(controlLeft[:]),
        fletui::KeyCode.Left,
        0,
        false,
        false,
        true,
        "CSI 1;5 D decodes as Ctrl+Left"
    );
    assert_key_event(
        t,
        fletui::decode_escape_sequence(allDown[:]),
        fletui::KeyCode.Down,
        0,
        true,
        true,
        true,
        "CSI 1;8 B decodes as Shift+Alt+Ctrl+Down"
    );
}

test decoder_starts_with_an_empty_buffer(&testing::UnitTest t) {
    decoder := fletui::Decoder::init();
    pending := decoder.pending();

    assert_buffered_len(t, &decoder, 0, "a new decoder has no buffered input");
    t->recordAssertion(
        pending.len() == 0,
        "decoder.pending().len() == 0",
        "a new decoder has no pending input"
    );
}

test decoder_feed_owns_the_input_bytes(&testing::UnitTest t) {
    decoder := fletui::Decoder::init();
    [2]u8 input = [27, 91];

    feedErr := decoder.feed(input[:]);
    input[0] = 0;
    pending := decoder.pending();

    assert_none(t, &feedErr, "feedErr == none", "feeding input succeeds");
    assert_buffered_len(t, &decoder, 2, "feed buffers both input bytes");
    t->recordAssertion(
        pending[0] == 27,
        "pending[0] == Escape",
        "feed owns the first input byte"
    );
    t->recordAssertion(
        pending[1] == 91,
        "pending[1] == '['",
        "feed owns the second input byte"
    );
}

test decoder_feed_appends_chunks_in_order(&testing::UnitTest t) {
    decoder := fletui::Decoder::init();
    [2]u8 first = [27, 91];
    [1]u8 second = [65];

    firstError := decoder.feed(first[:]);
    secondError := decoder.feed(second[:]);
    pending := decoder.pending();

    assert_none(
        t,
        &firstError,
        "firstError == none",
        "feeding the first chunk succeeds"
    );
    assert_none(
        t,
        &secondError,
        "secondError == none",
        "feeding the second chunk succeeds"
    );
    assert_buffered_len(t, &decoder, 3, "feed appends all three bytes");
    t->recordAssertion(
        pending[0] == 27,
        "pending[0] == Escape",
        "the first chunk's first byte remains first"
    );
    t->recordAssertion(
        pending[1] == 91,
        "pending[1] == '['",
        "the first chunk's second byte remains second"
    );
    t->recordAssertion(
        pending[2] == 65,
        "pending[2] == 'A'",
        "the appended byte follows the first chunk"
    );
}

test decoder_feed_accepts_an_empty_chunk(&testing::UnitTest t) {
    decoder := fletui::Decoder::init();
    [0]u8 empty = none;

    feedError := decoder.feed(empty[:]);

    assert_none(t, &feedError, "feedError == none", "feeding an empty chunk succeeds");
    assert_buffered_len(t, &decoder, 0, "feeding an empty chunk leaves no input");
}

test decoder_next_event_needs_input_when_empty(&testing::UnitTest t) {
    decoder := fletui::Decoder::init();

    event, decodeError := decoder.nextEvent();

    assert_none(
        t,
        &event,
        "event == none",
        "an empty decoder produces no event"
    );
    assert_none(
        t,
        &decodeError,
        "decodeError == none",
        "an empty decoder produces no error"
    );
    assert_buffered_len(t, &decoder, 0, "an empty decoder remains empty");
}

test decoder_next_event_decodes_and_consumes_plain_ascii(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [1]u8 input = [97];

    feedError := decoder.feed(input[:]);
    event, decodeError := decoder.nextEvent();

    assert_none(t, &feedError, "feedError == none", "feeding ASCII succeeds");
    assert_none(t, &decodeError, "decodeError == none", "decoding ASCII succeeds");
    assert_buffered_len(t, &decoder, 0, "a decoded ASCII byte is consumed");
    assert_key_event(
        t,
        event,
        fletui::KeyCode.Character,
        97,
        false,
        false,
        false,
        "plain ASCII produces a character event"
    );
}

test decoder_next_event_returns_multiple_buffered_events(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [2]u8 input = [97, 98];

    feedError := decoder.feed(input[:]);
    first, firstError := decoder.nextEvent();
    second, secondError := decoder.nextEvent();
    remaining, remainingError := decoder.nextEvent();

    assert_none(t, &feedError, "feedError == none", "feeding both bytes succeeds");
    assert_none(t, &firstError, "firstError == none", "decoding the first byte succeeds");
    assert_none(t, &secondError, "secondError == none", "decoding the second byte succeeds");
    assert_none(
        t,
        &remainingError,
        "remainingError == none",
        "reading after both events produces no error"
    );
    assert_none(
        t,
        &remaining,
        "remaining == none",
        "reading after both events produces no event"
    );
    assert_buffered_len(t, &decoder, 0, "successive calls drain the buffer");
    assert_key_event(
        t,
        first,
        fletui::KeyCode.Character,
        97,
        false,
        false,
        false,
        "the first buffered byte is decoded first"
    );
    assert_key_event(
        t,
        second,
        fletui::KeyCode.Character,
        98,
        false,
        false,
        false,
        "the second buffered byte is decoded second"
    );
}

test decoder_next_event_consumes_invalid_ascii_and_recovers(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [2]u8 input = [0, 113];

    feedError := decoder.feed(input[:]);
    invalidEvent, invalidError := decoder.nextEvent();
    validEvent, validError := decoder.nextEvent();

    assert_none(t, &feedError, "feedError == none", "feeding mixed input succeeds");
    assert_none(
        t,
        &invalidEvent,
        "invalidEvent == none",
        "invalid ASCII produces no event"
    );
    t->recordAssertion(
        invalidError == fletui::DecodeError.InvalidInput,
        "invalidError == DecodeError.InvalidInput",
        "invalid ASCII reports invalid input"
    );
    assert_none(
        t,
        &validError,
        "validError == none",
        "valid input after an invalid byte still decodes"
    );
    assert_buffered_len(t, &decoder, 0, "invalid and valid bytes are consumed");
    assert_key_event(
        t,
        validEvent,
        fletui::KeyCode.Character,
        113,
        false,
        false,
        false,
        "valid input following an invalid byte is decoded"
    );
}

test decoder_keeps_a_standalone_escape_pending(&testing::UnitTest t) {
    decoder := fletui::Decoder::init();
    [1]u8 input = [27];

    feedError := decoder.feed(input[:]);
    event, decodeError := decoder.nextEvent();

    assert_none(t, &feedError, "feedError == none", "feeding Escape succeeds");
    assert_none(t, &event, "event == none", "a standalone Escape remains pending");
    assert_none(
        t,
        &decodeError,
        "decodeError == none",
        "a pending Escape is not invalid input"
    );
    assert_buffered_len(t, &decoder, 1, "the pending Escape remains buffered");
}

test decoder_keeps_a_utf8_leading_byte_pending(&testing::UnitTest t) {
    decoder := fletui::Decoder::init();
    [1]u8 input = [240];

    feedError := decoder.feed(input[:]);
    event, decodeError := decoder.nextEvent();

    assert_none(t, &feedError, "feedError == none", "feeding a UTF-8 lead byte succeeds");
    assert_none(t, &event, "event == none", "an incomplete UTF-8 value emits no event");
    assert_none(
        t,
        &decodeError,
        "decodeError == none",
        "an incomplete UTF-8 value is not invalid input"
    );
    assert_buffered_len(t, &decoder, 1, "the UTF-8 lead byte remains buffered");
}

test decoder_waits_for_a_fragmented_csi_sequence(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [1]u8 escape = [27];
    [1]u8 introducer = [91];
    [1]u8 finalByte = [65];

    firstFeedError := decoder.feed(escape[:]);
    firstEvent, firstDecodeError := decoder.nextEvent();

    secondFeedError := decoder.feed(introducer[:]);
    secondEvent, secondDecodeError := decoder.nextEvent();

    thirdFeedError := decoder.feed(finalByte[:]);
    finalEvent, finalDecodeError := decoder.nextEvent();

    assert_none(t, &firstFeedError, "firstFeedError == none", "feeding Escape succeeds");
    assert_none(t, &firstEvent, "firstEvent == none", "Escape alone emits no event");
    assert_none(
        t,
        &firstDecodeError,
        "firstDecodeError == none",
        "Escape alone remains incomplete"
    );
    assert_none(
        t,
        &secondFeedError,
        "secondFeedError == none",
        "feeding the CSI introducer succeeds"
    );
    assert_none(
        t,
        &secondEvent,
        "secondEvent == none",
        "an incomplete CSI sequence emits no event"
    );
    assert_none(
        t,
        &secondDecodeError,
        "secondDecodeError == none",
        "an incomplete CSI sequence is not invalid"
    );
    assert_none(
        t,
        &thirdFeedError,
        "thirdFeedError == none",
        "feeding the CSI final byte succeeds"
    );
    assert_none(
        t,
        &finalDecodeError,
        "finalDecodeError == none",
        "the complete CSI sequence decodes successfully"
    );
    assert_buffered_len(t, &decoder, 0, "the complete CSI sequence is consumed");
    assert_key_event(
        t,
        finalEvent,
        fletui::KeyCode.Up,
        0,
        false,
        false,
        false,
        "fragmented CSI A decodes as Up"
    );
}

test decoder_waits_for_a_fragmented_modified_csi_sequence(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [3]u8 first = [27, 91, 49];
    [2]u8 second = [59, 53];
    [1]u8 third = [68];

    firstFeedError := decoder.feed(first[:]);
    firstEvent, firstDecodeError := decoder.nextEvent();

    secondFeedError := decoder.feed(second[:]);
    secondEvent, secondDecodeError := decoder.nextEvent();

    thirdFeedError := decoder.feed(third[:]);
    finalEvent, finalDecodeError := decoder.nextEvent();

    assert_none(
        t,
        &firstFeedError,
        "firstFeedError == none",
        "feeding the first CSI chunk succeeds"
    );
    assert_none(t, &firstEvent, "firstEvent == none", "the first CSI chunk emits no event");
    assert_none(
        t,
        &firstDecodeError,
        "firstDecodeError == none",
        "the first CSI chunk remains incomplete"
    );
    assert_none(t, &secondFeedError, "secondFeedError == none", "feeding CSI modifiers succeeds");
    assert_none(t, &secondEvent, "secondEvent == none", "CSI modifiers alone emit no event");
    assert_none(
        t,
        &secondDecodeError,
        "secondDecodeError == none",
        "CSI modifiers without a final byte remain incomplete"
    );
    assert_none(t, &thirdFeedError, "thirdFeedError == none", "feeding the final byte succeeds");
    assert_none(
        t,
        &finalDecodeError,
        "finalDecodeError == none",
        "the completed modified CSI sequence decodes successfully"
    );
    assert_buffered_len(t, &decoder, 0, "the modified CSI sequence is consumed");
    assert_key_event(
        t,
        finalEvent,
        fletui::KeyCode.Left,
        0,
        false,
        false,
        true,
        "fragmented CSI 1;5 D decodes as Control+Left"
    );
}

test decoder_decodes_ss3_and_preserves_following_input(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [4]u8 input = [27, 79, 65, 120];

    feedError := decoder.feed(input[:]);
    upEvent, upError := decoder.nextEvent();
    characterEvent, characterError := decoder.nextEvent();

    assert_none(t, &feedError, "feedError == none", "feeding SS3 and trailing input succeeds");
    assert_none(t, &upError, "upError == none", "decoding SS3 succeeds");
    assert_none(
        t,
        &characterError,
        "characterError == none",
        "decoding input after SS3 succeeds"
    );
    assert_buffered_len(t, &decoder, 0, "SS3 and following input are consumed");
    assert_key_event(
        t,
        upEvent,
        fletui::KeyCode.Up,
        0,
        false,
        false,
        false,
        "SS3 A decodes as Up"
    );
    assert_key_event(
        t,
        characterEvent,
        fletui::KeyCode.Character,
        120,
        false,
        false,
        false,
        "input following SS3 remains available"
    );
}

test decoder_rejects_unknown_csi_and_recovers(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [4]u8 input = [27, 91, 90, 113];

    feedError := decoder.feed(input[:]);
    invalidEvent, invalidError := decoder.nextEvent();
    validEvent, validError := decoder.nextEvent();

    assert_none(t, &feedError, "feedError == none", "feeding unknown CSI input succeeds");
    assert_none(
        t,
        &invalidEvent,
        "invalidEvent == none",
        "an unknown CSI sequence produces no event"
    );
    t->recordAssertion(
        invalidError == fletui::DecodeError.InvalidInput,
        "invalidError == DecodeError.InvalidInput",
        "an unknown CSI sequence reports invalid input"
    );
    assert_none(t, &validError, "validError == none", "input after unknown CSI decodes");
    assert_buffered_len(t, &decoder, 0, "unknown CSI and following input are consumed");
    assert_key_event(
        t,
        validEvent,
        fletui::KeyCode.Character,
        113,
        false,
        false,
        false,
        "plain input following unknown CSI is preserved"
    );
}

test decoder_decodes_multibyte_utf8_code_points(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [9]u8 input = [
        194, 162,
        226, 130, 172,
        240, 159, 153, 130,
    ];

    feedError := decoder.feed(input[:]);
    cent, centError := decoder.nextEvent();
    euro, euroError := decoder.nextEvent();
    smile, smileError := decoder.nextEvent();

    assert_none(t, &feedError, "feedError == none", "feeding UTF-8 input succeeds");
    assert_none(t, &centError, "centError == none", "decoding two-byte UTF-8 succeeds");
    assert_none(t, &euroError, "euroError == none", "decoding three-byte UTF-8 succeeds");
    assert_none(t, &smileError, "smileError == none", "decoding four-byte UTF-8 succeeds");
    assert_buffered_len(t, &decoder, 0, "all complete UTF-8 code points are consumed");
    assert_key_event(
        t,
        cent,
        fletui::KeyCode.Character,
        162,
        false,
        false,
        false,
        "two-byte UTF-8 decodes to U+00A2"
    );
    assert_key_event(
        t,
        euro,
        fletui::KeyCode.Character,
        8364,
        false,
        false,
        false,
        "three-byte UTF-8 decodes to U+20AC"
    );
    assert_key_event(
        t,
        smile,
        fletui::KeyCode.Character,
        128578,
        false,
        false,
        false,
        "four-byte UTF-8 decodes to U+1F642"
    );
}

test decoder_waits_for_fragmented_utf8(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [1]u8 first = [240];
    [2]u8 middle = [159, 153];
    [1]u8 last = [130];

    firstFeedError := decoder.feed(first[:]);
    firstEvent, firstDecodeError := decoder.nextEvent();

    middleFeedError := decoder.feed(middle[:]);
    middleEvent, middleDecodeError := decoder.nextEvent();

    lastFeedError := decoder.feed(last[:]);
    finalEvent, finalDecodeError := decoder.nextEvent();

    assert_none(
        t,
        &firstFeedError,
        "firstFeedError == none",
        "feeding the UTF-8 lead byte succeeds"
    );
    assert_none(t, &firstEvent, "firstEvent == none", "a UTF-8 lead byte emits no event");
    assert_none(
        t,
        &firstDecodeError,
        "firstDecodeError == none",
        "a UTF-8 lead byte remains incomplete"
    );
    assert_none(
        t,
        &middleFeedError,
        "middleFeedError == none",
        "feeding middle UTF-8 bytes succeeds"
    );
    assert_none(t, &middleEvent, "middleEvent == none", "incomplete UTF-8 emits no event");
    assert_none(
        t,
        &middleDecodeError,
        "middleDecodeError == none",
        "incomplete UTF-8 is not invalid"
    );
    assert_none(
        t,
        &lastFeedError,
        "lastFeedError == none",
        "feeding the final UTF-8 byte succeeds"
    );
    assert_none(
        t,
        &finalDecodeError,
        "finalDecodeError == none",
        "completed fragmented UTF-8 decodes successfully"
    );
    assert_buffered_len(t, &decoder, 0, "completed fragmented UTF-8 is consumed");
    assert_key_event(
        t,
        finalEvent,
        fletui::KeyCode.Character,
        128578,
        false,
        false,
        false,
        "the completed fragmented sequence decodes to U+1F642"
    );
}

test decoder_rejects_invalid_utf8_and_preserves_following_ascii(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [3]u8 input = [226, 40, 113];

    feedError := decoder.feed(input[:]);
    invalidEvent, invalidError := decoder.nextEvent();
    parenthesis, parenthesisError := decoder.nextEvent();
    character, characterError := decoder.nextEvent();

    assert_none(t, &feedError, "feedError == none", "feeding malformed UTF-8 succeeds");
    assert_none(
        t,
        &invalidEvent,
        "invalidEvent == none",
        "malformed UTF-8 produces no event"
    );
    t->recordAssertion(
        invalidError == fletui::DecodeError.InvalidInput,
        "invalidError == DecodeError.InvalidInput",
        "malformed UTF-8 reports invalid input"
    );
    assert_none(
        t,
        &parenthesisError,
        "parenthesisError == none",
        "ASCII immediately after malformed UTF-8 decodes"
    );
    assert_none(
        t,
        &characterError,
        "characterError == none",
        "later ASCII after malformed UTF-8 decodes"
    );
    assert_buffered_len(t, &decoder, 0, "malformed UTF-8 and following ASCII are consumed");
    assert_key_event(
        t,
        parenthesis,
        fletui::KeyCode.Character,
        40,
        false,
        false,
        false,
        "ASCII following an invalid UTF-8 lead byte is preserved"
    );
    assert_key_event(
        t,
        character,
        fletui::KeyCode.Character,
        113,
        false,
        false,
        false,
        "later ASCII remains decodable after UTF-8 recovery"
    );
}

test decoder_decodes_alt_ascii_and_control_keys(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [4]u8 input = [27, 120, 27, 1];

    feedError := decoder.feed(input[:]);
    altX, altXError := decoder.nextEvent();
    altControlA, altControlAError := decoder.nextEvent();

    assert_none(t, &feedError, "feedError == none", "feeding Alt sequences succeeds");
    assert_none(t, &altXError, "altXError == none", "decoding Alt+x succeeds");
    assert_none(
        t,
        &altControlAError,
        "altControlAError == none",
        "decoding Alt+Control+A succeeds"
    );
    assert_buffered_len(t, &decoder, 0, "both Alt sequences are consumed");
    assert_key_event(
        t,
        altX,
        fletui::KeyCode.Character,
        120,
        false,
        true,
        false,
        "Escape followed by x decodes as Alt+x"
    );
    assert_key_event(
        t,
        altControlA,
        fletui::KeyCode.Character,
        97,
        false,
        true,
        true,
        "Escape followed by Ctrl+A preserves both modifiers"
    );
}

test decoder_waits_for_fragmented_alt_utf8(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [3]u8 first = [27, 240, 159];
    [2]u8 second = [153, 130];

    firstFeedError := decoder.feed(first[:]);
    pendingEvent, pendingError := decoder.nextEvent();

    secondFeedError := decoder.feed(second[:]);
    finalEvent, finalError := decoder.nextEvent();

    assert_none(
        t,
        &firstFeedError,
        "firstFeedError == none",
        "feeding partial Alt+Unicode succeeds"
    );
    assert_none(
        t,
        &pendingEvent,
        "pendingEvent == none",
        "partial Alt+Unicode emits no event"
    );
    assert_none(
        t,
        &pendingError,
        "pendingError == none",
        "partial Alt+Unicode remains incomplete"
    );
    assert_none(
        t,
        &secondFeedError,
        "secondFeedError == none",
        "feeding remaining Unicode succeeds"
    );
    assert_none(t, &finalError, "finalError == none", "complete Alt+Unicode decodes successfully");
    assert_buffered_len(t, &decoder, 0, "complete Alt+Unicode is consumed");
    assert_key_event(
        t,
        finalEvent,
        fletui::KeyCode.Character,
        128578,
        false,
        true,
        false,
        "fragmented Escape plus UTF-8 decodes as Alt+Unicode"
    );
}

test decoder_flushes_a_standalone_escape_after_timeout(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [1]u8 input = [27];

    feedError := decoder.feed(input[:]);
    pendingEvent, pendingError := decoder.nextEvent();
    waitingBefore := decoder.hasPendingEscape();
    escapeEvent, escapeError := decoder.flushEscape();

    assert_none(t, &feedError, "feedError == none", "feeding Escape succeeds");
    assert_none(t, &pendingEvent, "pendingEvent == none", "Escape waits before timeout");
    assert_none(
        t,
        &pendingError,
        "pendingError == none",
        "a waiting Escape is not invalid"
    );
    t->recordAssertion(
        waitingBefore,
        "hasPendingEscape() before flush",
        "the decoder recognizes a pending Escape"
    );
    assert_none(t, &escapeError, "escapeError == none", "flushing Escape succeeds");
    t->recordAssertion(
        !decoder.hasPendingEscape(),
        "!hasPendingEscape() after flush",
        "the decoder no longer has a pending Escape"
    );
    assert_buffered_len(t, &decoder, 0, "flushing Escape consumes it");
    assert_key_event(
        t,
        escapeEvent,
        fletui::KeyCode.Escape,
        0,
        false,
        false,
        false,
        "the timeout flush produces Escape"
    );
}

test decoder_flushes_only_escape_from_incomplete_csi(
    &testing::UnitTest t
) {
    decoder := fletui::Decoder::init();
    [2]u8 input = [27, 91];

    feedError := decoder.feed(input[:]);
    pendingEvent, pendingError := decoder.nextEvent();
    escapeEvent, escapeError := decoder.flushEscape();
    bracketEvent, bracketError := decoder.nextEvent();

    assert_none(t, &feedError, "feedError == none", "feeding incomplete CSI succeeds");
    assert_none(
        t,
        &pendingEvent,
        "pendingEvent == none",
        "incomplete CSI waits for more input"
    );
    assert_none(
        t,
        &pendingError,
        "pendingError == none",
        "incomplete CSI is not invalid"
    );
    assert_none(t, &escapeError, "escapeError == none", "flushing CSI Escape succeeds");
    assert_none(
        t,
        &bracketError,
        "bracketError == none",
        "the remaining bracket decodes successfully"
    );
    assert_buffered_len(t, &decoder, 0, "Escape and remaining bracket are consumed");
    assert_key_event(
        t,
        escapeEvent,
        fletui::KeyCode.Escape,
        0,
        false,
        false,
        false,
        "the timed-out prefix becomes Escape"
    );
    assert_key_event(
        t,
        bracketEvent,
        fletui::KeyCode.Character,
        91,
        false,
        false,
        false,
        "the incomplete CSI introducer remains as ordinary input"
    );
}

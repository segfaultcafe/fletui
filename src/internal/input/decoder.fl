module fletui;
under namespace root;

@imports
    :: lib::std::text::{strings, utf8, errors as text_errors}
    :: lib::std::containers::collections as coll;

const usize MAX_ESCAPE_SEQUENCE = 32;

error DecodeError {
    InvalidInput,
}

structure Decoder {
    private coll::Array<u8> buffer;
    private usize offset;
};

// Creates an empty decoder with no buffered terminal input.
Decoder Decoder::init() override {
    return build Decoder {
        self.buffer = coll::Array<u8>::init();
        self.offset = 0;
    };
}

// Appends an input chunk to decoder-owned storage without decoding it.
error Decoder::feed(&self, []const u8 input) {
    return self->buffer.append(input);
}

// Reports whether the next buffered event begins with Escape and may need a
// timeout before it can be distinguished from an escape sequence or Alt key.
bool Decoder::hasPendingEscape(&const self) {
    if self->bufferedLen() == 0 {
        return false;
    }

    bytes := self->pending();
    return bytes[0] == 27;
}

// Resolves a pending Escape after its input timeout. A complete sequence is
// decoded normally; an incomplete prefix emits Escape and leaves later bytes.
(Event, error) Decoder::flushEscape(&self) {
    if !self->hasPendingEscape() {
        return (none, none);
    }

    event, decodeErr := self->nextEscapeEvent();
    if event != none or decodeErr != none {
        return (event, decodeErr);
    }

    // The seq is still incomplete after the timeout
    self->consume(1);
    return (key_event(KeyCode.Escape, 0, none), none);
}

// Decodes and consumes the next complete buffered event. Incomplete input
// remains buffered and returns no event or error.
(Event, error) Decoder::nextEvent(&self) {
    if self->bufferedLen() == 0 {
        return (none, none);
    }

    u8 value;
    {
        pending := self->pending();
        value = pending[0];
    }

    if value == 27 {
        return self->nextEscapeEvent();
    }

    if value >= 128 {
        return self->nextUtf8Event();
    }

    event := decode_plain_key(value);
    self->consume(1);

    if event == none {
        return (none, DecodeError.InvalidInput);
    }

    return (event, none);
}

// Decodes an Escape-prefixed ASCII, control, or UTF-8 value as an Alt key.
// Incomplete UTF-8 remains buffered; invalid input consumes only Escape.
private (Event, error) Decoder::nextAltEvent(&self) {
    u8 value = self->pending()[1];
    if value < 128 {
        event := decode_plain_key(value);
        self->consume(2);

        if event == none {
            return (none, DecodeError.InvalidInput);
        }

        event.key.modifiers.alt = true;
        return (event, none);
    }

    const usize OFFSET = 1;
    codepoint, nextOffset := try self->decodePendingUtf8(OFFSET) peek err as error {
        if err == text_errors::Utf8Error.Truncated {
            return none;
        }

        // Consume Escape; the invalid byte is handled by the next call.
        self->consume(1);
        err = DecodeError.InvalidInput;
    };

    self->consume(nextOffset);
    event := key_event(KeyCode.Character, codepoint, none);
    event.key.modifiers.alt = true;
    return (event, none);
}

// Decodes the next UTF-8 scalar. Truncated input remains buffered, while an
// invalid sequence consumes only its leading byte so later input survives.
private (Event, error) Decoder::nextUtf8Event(&self) {
    const usize OFFSET = 0;
    codepoint, byteCount := try self->decodePendingUtf8(OFFSET) peek err as error {
        if err == text_errors::Utf8Error.Truncated {
            return none;
        }

        // consume only the invalid leading byte so following input survives
        self->consume(1);
        err = DecodeError.InvalidInput;
    };

    self->consume(byteCount);
    return (key_event(KeyCode.Character, codepoint, none), none);
}

// Decodes the next CSI, SS3, or Alt sequence. Incomplete sequences remain
// buffered; malformed and unsupported complete sequences are consumed.
private (Event, error) Decoder::nextEscapeEvent(&self) {
    u8 introducer;
    {
        // Since self->pending() borrows self, we use it inside a scoped
        // block
        bytes := self->pending();

        // A standalone Escape may still become CSI, SS3, or Alt+key
        if bytes.len() < 2 {
            return (none, none);
        }

        introducer = bytes[1];
    }

    if introducer != 79 and introducer != 91 {
        return self->nextAltEvent();
    }

    usize sequenceLen;
    bool malformed;
    {
        bytes := self->pending();
        if introducer == 79 {
            if bytes.len() < 3 {
                return (none, none);
            }

            sequenceLen = 3;
        } else {
            // CSI parameters/intermediates are 0x20-0x3f
            usize i = 2;
            while i < bytes.len() and i < MAX_ESCAPE_SEQUENCE {
                u8 val = bytes[i];

                if val >= 64 and val <= 126 {
                    sequenceLen = i + 1;
                    break;
                }

                if val < 32 or val > 63 {
                    sequenceLen = i + 1;
                    malformed = true;
                    break;
                }

                i++;
            }

            if sequenceLen == 0 {
                if bytes.len() < MAX_ESCAPE_SEQUENCE {
                    return (none, none);
                }

                sequenceLen = MAX_ESCAPE_SEQUENCE;
                malformed = true;
            }
        }
    }

    if malformed {
        self->consume(sequenceLen);
        return (none, DecodeError.InvalidInput);
    }

    Event event;
    {
        bytes := self->pending();
        event = decode_escape_sequence(bytes[:sequenceLen]);
    }

    self->consume(sequenceLen);
    if event == none {
        return (none, DecodeError.InvalidInput);
    }

    return (event, none);
}

// Borrows the unconsumed suffix of the decoder-owned byte buffer.
private []const u8 Decoder::pending(&const self) <-self {
    bytes := self->buffer.view();
    return bytes[self->offset:];
}

// Decodes one UTF-8 scalar from the pending bytes at offset and returns the
// offset immediately following that scalar.
private (u32, usize, error) Decoder::decodePendingUtf8(&const self, usize offset) {
    bytes := self->pending();
    text := strings::stringv_from_bytes(bytes);
    return utf8::decode(text, offset);
}

// Advances past count pending bytes and releases storage once fully consumed.
private void Decoder::consume(&self, usize count) {
    self->offset += count;

    if self->offset == self->buffer.len() {
        self->buffer.clear();
        self->offset = 0;
    }
}

// Returns the number of buffered bytes that have not yet been consumed.
private usize Decoder::bufferedLen(&const self) {
    return self->buffer.len() - self->offset;
}

// Decoder free functions

// Builds a key event with an empty resize payload.
Event key_event(KeyCode code, u32 codepoint, KeyModifiers modifiers) {
    return build Event {
        self.kind = EventKind.Key;
        self.key = build KeyEvent {
            self.code = code;
            self.modifiers = modifiers;
            self.codepoint = codepoint; 
        };
    };
}

// Decodes one ASCII or control byte, returning no event for unsupported bytes.
Event decode_plain_key(u8 value) {
    if value == 27 {
        return key_event(KeyCode.Escape, 0, none);
    }

    if value == 10 or value == 13 {
        return key_event(KeyCode.Enter, 0, none);
    }

    if value == 8 or value == 127 {
        return key_event(KeyCode.Backspace, 0, none);
    }

    if value == 9 {
        return key_event(KeyCode.Tab, 0, none);
    }

    // Raw terminals encode Ctrl+A through Ctrl+Z as bytes 1 through 26
    if value >= 1 and value <= 26 {
        return key_event(
            KeyCode.Character,
            value.cast<u32> + 96,
            build KeyModifiers {
                self.control = true;
        });
    }

    if value >= 32 and value <= 126 {
        return key_event(
            KeyCode.Character,
            value.cast<u32>,
            none
        );
    }

    return none;
}

// Decodes one complete supported CSI or SS3 byte sequence. Incomplete,
// malformed, unsupported, or oversized sequences return no event.
Event decode_escape_sequence([]const u8 sequence) {
    if sequence.len() < 3 or sequence[0] != 27 {
        return none;
    }

    // CSI and SS3 use the same final bytes for navigation keys
    if sequence.len() == 3 {
        if sequence[1] == 91 or sequence[1] == 79 {
            return ansi_navigation_event(sequence[2]);
        }

        return none;
    }

    // Longer forms below are CSI-only
    if sequence[1] != 91 {
        return none;
    }

    if sequence.len() == 4 and sequence[3] == 126 {
        return ansi_csi_tilde_event(sequence[2]);
    }

    // Modified navigation: CSI 1 ; modifier final-byte
    if sequence.len() == 6 and sequence[2] == 49 and sequence[3] == 59 {
        return ansi_csi_modified_event(sequence[4], sequence[5]);
    }

    return none;
}

// Maps a supported single-byte CSI tilde parameter to its logical key.
Event ansi_csi_tilde_event(u8 parameter) {
    if parameter == 49 {
        return key_event(KeyCode.Home, 0, none);
    }
    if parameter == 50 {
        return key_event(KeyCode.Insert, 0, none);
    }
    if parameter == 51 {
        return key_event(KeyCode.Delete, 0, none);
    }
    if parameter == 52 {
        return key_event(KeyCode.End, 0, none);
    }
    if parameter == 53 {
        return key_event(KeyCode.PageUp, 0, none);
    }
    if parameter == 54 {
        return key_event(KeyCode.PageDown, 0, none);
    }

    return none;
}

// Maps a supported CSI or SS3 final byte to its logical navigation key.
Event ansi_navigation_event(u8 finalByte) {
    if finalByte == 65 {
        return key_event(KeyCode.Up, 0, none);
    }
    if finalByte == 66 {
        return key_event(KeyCode.Down, 0, none);
    }
    if finalByte == 67 {
        return key_event(KeyCode.Right, 0, none);
    }
    if finalByte == 68 {
        return key_event(KeyCode.Left, 0, none);
    }
    if finalByte == 72 {
        return key_event(KeyCode.Home, 0, none);
    }
    if finalByte == 70 {
        return key_event(KeyCode.End, 0, none);
    }

    return none;
}

// Decodes a CSI navigation key with an xterm modifier parameter.
Event ansi_csi_modified_event(u8 modifierByte, u8 finalByte) {
    // Modifier values are ASCII '2' through '8'.
    if modifierByte < 50 or modifierByte > 56 {
        return none;
    }

    event := ansi_navigation_event(finalByte);
    if event == none {
        return none;
    }

    // ANSI modifier parameter minus one is a modifier bitset:
    // bit 0 = Shift, bit 1 = Alt, bit 2 = Control.
    u8 bits = modifierByte - 49;
    event.key.modifiers = build KeyModifiers {
        self.shift = (bits & 1) != 0;
        self.alt = (bits & 2) != 0;
        self.control = (bits & 4) != 0;
    };

    return event;
}

module fletui;

const i32 ESCAPE_TIMEOUT_MS = 25;
const i32 WAIT_INDEFINITELY = -1;

structure PollResult {
    bool inputReady;
    bool resizeReady;
};

// Acquires the process terminal, enables raw mode, and initializes its input
// decoder. The returned Terminal owns the native handle until teardown.
(Terminal, error) Terminal::open() {
    *void handle = null;
    unsafe {
        i32 status = fletui_v1_terminal_open(&raw handle);
        try error_from_status(status, FletuiError.OpenFailed);
    }

    return (build Terminal {
        self.handle = handle;
        self.decoder = Decoder::init();
    }, none);
}

// Restores the terminal state and releases its native handle. Tearing down an
// already closed Terminal has no effect.
void Terminal::tear(&self) override {
    if self->handle == null {
        return;
    }

    *void handle = self->handle;
    self->handle = null;
    unsafe {
        fletui_v1_terminal_close(handle);
    }
}

// Reports whether this Terminal currently owns an open native handle.
bool Terminal::isOpen(&const self) {
    return self->handle != null;
}

// Returns the terminal viewport dimensions in character cells.
(Size, error) Terminal::size(&const self) {
    try self->healthCheck();
    u16 columns = 0;
    u16 rows = 0;
    unsafe {
        i32 status = fletui_v1_terminal_size(
            self->handle,
            &raw columns,
            &raw rows
        );
        try error_from_status(status, FletuiError.SizeFailed);
    }

    return (build Size {
        self.columns = columns;
        self.rows = rows;
    }, none);
}

// Writes the complete source string to the terminal output.
error Terminal::writeAll(&const self, stringv source) {
    try self->healthCheck();
    unsafe {
        i32 status = fletui_v1_terminal_write_all(
            self->handle,
            source.data(),
            source.len().cast<usize>
        );
        try error_from_status(status, FletuiError.WriteFailed);
    }

    return none;
}

// Blocks until the next complete terminal event is available. Malformed input
// is consumed and skipped, while incomplete input remains buffered.
(Event, error) Terminal::readEvent(&self) {
    try self->healthCheck();
    [256]u8 input;
    while true {
        event, decodeErr := self->decoder.nextEvent();
        if decodeErr == DecodeError.InvalidInput {
            proceed;
        }

        if decodeErr != none {
            return (none, decodeErr);
        }

        if event != none {
            return (event, none);
        }

        i32 timeoutMs = WAIT_INDEFINITELY;
        if self->decoder.hasPendingEscape() {
            timeoutMs = ESCAPE_TIMEOUT_MS;
        }

        readiness := try self->poll(timeoutMs);
        if readiness.resizeReady {
            size := try self->size();

            return (build Event {
                self.kind = EventKind.Resize;
                self.size = size;
            }, none);
        }

        if !readiness.inputReady {
            event, flushErr := self->decoder.flushEscape();
            if flushErr == DecodeError.InvalidInput {
                proceed;
            }

            if flushErr != none {
                return (none, flushErr);
            }

            if event != none {
                return (event, none);
            }

            proceed;
        }

        bytesRead := try self->read(input[:]);
        if bytesRead == 0 {
            return (none, FletuiError.ReadFailed);
        }

        try self->decoder.feed(input[:bytesRead]);
    }
}

// Waits until input, a resize notification, or timeoutMs elapses. A timeout
// of -1 waits indefinitely; zero checks without blocking.
private (PollResult, error) Terminal::poll(&const self, i32 timeoutMs) {
    try self->healthCheck();

    u8 inputReady = 0, resizeReady = 0;
    unsafe {
        i32 status = fletui_v1_terminal_poll(
            self->handle,
            timeoutMs,
            &raw inputReady,
            &raw resizeReady
        );

        try error_from_status(status, FletuiError.PollFailed);
    }

    return (build PollResult {
        self.inputReady = inputReady != 0;
        self.resizeReady = resizeReady != 0;
    }, none);
}

// Reads the bytes currently available without blocking. This stays private so
// raw reads cannot bypass and desynchronize the persistent event decoder.
private (usize, error) Terminal::read(&const self, []u8 destination) {
    try self->healthCheck();
    usize bytesRead = 0;
    unsafe {
        i32 status = fletui_v1_terminal_read(
            self->handle,
            destination.data(),
            destination.len(),
            &raw bytesRead
        );

        try error_from_status(status, FletuiError.ReadFailed);
    }

    return (bytesRead, none);
}

// Rejects operations on a Terminal that does not own a native handle.
private error Terminal::healthCheck(&const self) {
    if self->handle == null {
        return FletuiError.Closed;
    }

    return none;
}

